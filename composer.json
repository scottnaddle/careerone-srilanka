{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "apereo/phpcas": "^1.6",
        "barryvdh/laravel-dompdf": "^3.0",
        "bezhansalleh/filament-exceptions": "^2.1",
        "bezhansalleh/filament-shield": "^3.2",
        "cviebrock/eloquent-sluggable": "^10.0",
        "datlechin/filament-menu-builder": "^0.5.3",
        "doctrine/dbal": "3.8",
        "filament/filament": "^3.2",
        "filament/spatie-laravel-media-library-plugin": "^3.2",
        "google/analytics-data": "^0.24.0",
        "guzzlehttp/guzzle": "^7.2",
        "intervention/image": "2.7",
        "jenssegers/agent": "^2.6",
        "josespinal/filament-record-navigation": "^2.0",
        "joshembling/image-optimizer": "^1.6",
        "kenepa/banner": "^0.0.9",
        "kenepa/translation-manager": "^4.0",
        "kreait/firebase-php": "^7.14",
        "laravel/framework": "^10.10",
        "laravel/sanctum": "^3.3",
        "laravel/tinker": "^2.8",
        "maatwebsite/excel": "^3.1",
        "malzariey/filament-daterangepicker-filter": "^3.0",
        "mostafaznv/pdf-optimizer": "^1.2",
        "owenvoke/blade-entypo": "^2.2",
        "predis/predis": "^2.3",
        "pusher/pusher-php-server": "^7.2",
        "riverskies/laravel-mobile-detect": "^1.3",
        "spatie/laravel-medialibrary": "^11.9",
        "spatie/laravel-pdf": "^1.5",
        "spatie/laravel-permission": "^6.9",
        "spatie/laravel-sitemap": "^7.3",
        "tomatophp/filament-media-manager": "^1.1",
        "vish4395/laravel-file-viewer": "^1.0",
        "z3d0x/filament-logger": "^0.7.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": ["app/Helpers/helper.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
