# =============================================================
# CareerOne — Local Dev Environment (.env.local template)
# =============================================================
# Copy to .env and run `php artisan key:generate`
#
# Quick reference (non-standard ports to avoid local conflicts):
#   App      : http://localhost:18000
#   MySQL    : localhost:13306
#   Redis    : localhost:16379
#   Mailpit  : http://localhost:18025 (UI) / localhost:11025 (SMTP)
# =============================================================

APP_NAME="CareerOne"
APP_ENV=local
APP_KEY=                                # run: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:18000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------- Database ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=13306
DB_DATABASE=careerone
DB_USERNAME=careerone
DB_PASSWORD=careerone_pass

# ---------- Cache / Session / Queue (use file for dev simplicity) ----------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ---------- Redis (Predis client, but Laravel falls back to file driver fine) ----------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=null

# ---------- Mail (Mailpit catches everything locally) ----------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=11025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="careerone@local.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- CAS (Trainee SSO) — disabled in local dev ----------
# Trainee can still log in via email/password without CAS
CAS_HOSTNAME=localhost
CAS_CLIENT_SERVICE=http://localhost:18000
CAS_CLIENT_SERVICE1=http://localhost:18000

# ---------- Firebase (FCM push) — empty for local ----------
FIREBASE_CREDENTIALS=
FCM_SERVER_KEY=

# ---------- Google OAuth (optional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:18000/auth/google/callback

# ---------- AWS S3 (optional, defaults to local) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------- Pusher (optional, real-time) ----------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ---------- Vite / Frontend ----------
VITE_APP_NAME="${APP_NAME}"
